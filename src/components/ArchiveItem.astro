---
interface Props {
  period: string;
  company: string;
  location?: string;
  title: string;
  summary?: string;
  bullets?: string[];
  highlighted?: boolean;
  hideDivider?: boolean;
}

const {
  period,
  company,
  location,
  title,
  summary,
  bullets = [],
  highlighted = false,
  hideDivider = false,
} = Astro.props;

const normalizedCompany = company.trim();
const normalizedTitle = title.trim();
const headingText = normalizedCompany || normalizedTitle || period.trim();
const subheadingText =
  normalizedCompany && normalizedTitle ? normalizedTitle : undefined;
---

<article
  class:list={[
    "px-6 py-8 sm:px-8 sm:py-10",
    !hideDivider && "border-b border-border-muted last:border-b-0",
    highlighted && "border-l-2 border-l-accent-strong",
  ]}
>
  <div
    class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-ink-muted"
  >
    <span class="font-label tracking-wide">{period}</span>
    {
      highlighted && (
        <span class="bg-accent/15 px-2 py-1 font-medium text-ink">
          Current role
        </span>
      )
    }
  </div>
  <div class="mt-4">
    <h3
      class="font-headline text-xl font-semibold leading-snug tracking-tight sm:text-2xl"
    >
      {headingText}
    </h3>
    {
      subheadingText && (
        <p class="mt-1.5 text-sm font-medium leading-relaxed text-ink">
          {subheadingText}
        </p>
      )
    }
    {location && <p class="mt-2 text-xs text-ink-muted">{location}</p>}
  </div>
  {
    summary && (
      <p class="mt-5 max-w-prose text-sm leading-7 text-ink-muted">{summary}</p>
    )
  }
  {
    bullets.length > 0 && (
      <ul class="mt-5 max-w-prose space-y-3 pl-4 text-sm leading-7 text-ink-muted marker:text-ink-subtle list-disc">
        {bullets.map((bullet) => (
          <li class="pl-1">{bullet}</li>
        ))}
      </ul>
    )
  }
</article>
