---
interface Props {
  period: string;
  company: string;
  location?: string;
  title: string;
  summary?: string;
  bullets?: string[];
  roles?: { period: string; title: string; bullets: string[]; promoted?: boolean }[];
  highlighted?: boolean;
}

const {
  period,
  company,
  location,
  title,
  summary,
  bullets = [],
  roles = [],
  highlighted = false,
} = Astro.props;

const normalizedCompany = company.trim();
const normalizedTitle = title.trim();
const headingText = normalizedCompany || normalizedTitle || period.trim();
const subheadingText =
  normalizedCompany && normalizedTitle ? normalizedTitle : undefined;
---

<article
  class:list={[
    "px-6 py-8 sm:px-8 sm:py-10",
    "border-b border-border-muted last:border-b-0",
    highlighted && "border-l-4 border-l-accent-strong",
  ]}
>
  <div
    class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-ink-muted"
  >
    <span class="font-label tracking-wide">{period}</span>
    {
      highlighted && (
        <span class="bg-accent px-2 py-0.5 text-xs font-semibold text-accent-foreground">
          Current role
        </span>
      )
    }
  </div>
  <div class="mt-4">
    <h3
      class="font-headline text-xl font-semibold leading-snug tracking-tight sm:text-2xl"
    >
      {headingText}
    </h3>
    {
      subheadingText && (
        <p class="mt-1.5 text-base font-medium leading-relaxed text-ink">
          {subheadingText}
        </p>
      )
    }
    {location && <p class="mt-1 text-sm text-ink-muted">{location}</p>}
  </div>
  {
    summary && (
      <p class="mt-5 max-w-prose text-sm leading-7 text-ink-muted">{summary}</p>
    )
  }
  {
    roles.length > 0 && (
      <ol class="mt-6 space-y-8 border-l-2 border-border-muted pl-6">
        {roles.map((role) => (
          <li class="relative">
            <span
              class="absolute -left-[1.9rem] top-1.5 h-2.5 w-2.5 bg-accent-strong"
              aria-hidden="true"
            />
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <h4 class="text-base font-semibold text-ink">{role.title}</h4>
              {role.promoted && (
                <span class="bg-accent px-2 py-0.5 text-xs font-semibold text-accent-foreground">
                  Promoted
                </span>
              )}
            </div>
            <p class="mt-1 font-label text-sm text-ink-muted">{role.period}</p>
            <ul class="mt-4 max-w-prose list-disc space-y-3 pl-4 text-[0.9375rem] leading-7 text-ink-muted marker:text-accent-strong">
              {role.bullets.map((bullet) => (
                <li class="pl-1">{bullet}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    )
  }
  {
    bullets.length > 0 && (
      <ul class="mt-5 max-w-prose space-y-3 pl-4 text-[0.9375rem] leading-7 text-ink-muted marker:text-accent-strong list-disc">
        {bullets.map((bullet) => (
          <li class="pl-1">{bullet}</li>
        ))}
      </ul>
    )
  }
</article>
