---
import {
  CloudUpload,
  Database,
  LayoutTemplate,
  ServerCog,
} from "@lucide/astro";

interface Props {
  code: string;
  title: string;
  description: string;
  icon: string;
}

const { code, title, description, icon } = Astro.props;

const iconMap = {
  architecture: LayoutTemplate,
  developer_board: ServerCog,
  database: Database,
  cloud_upload: CloudUpload,
} as const;

const Icon = iconMap[icon as keyof typeof iconMap] ?? LayoutTemplate;
---

<article class="border border-border-muted bg-panel p-6">
  <div class="mb-6 flex items-center justify-between text-ink-muted">
    <Icon class="h-6 w-6" aria-hidden="true" />
    <span class="font-label text-[10px] tracking-wider">
      {code}
    </span>
  </div>

  <h3 class="font-headline text-lg font-semibold leading-snug tracking-tight">
    {title}
  </h3>
  <p class="mt-3 font-body text-sm leading-6 text-ink-muted">
    {description}
  </p>
</article>
