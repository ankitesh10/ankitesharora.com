---
import {
  CloudUpload,
  Database,
  LayoutTemplate,
  ServerCog,
} from "@lucide/astro";

interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;

const iconMap = {
  architecture: LayoutTemplate,
  developer_board: ServerCog,
  database: Database,
  cloud_upload: CloudUpload,
} as const;

const Icon = iconMap[icon as keyof typeof iconMap] ?? LayoutTemplate;
---

<article
  class="group border border-border-muted bg-panel p-6 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent-strong"
>
  <div
    class="mb-5 flex h-11 w-11 items-center justify-center bg-accent/20 text-ink transition-colors duration-200 group-hover:bg-accent group-hover:text-accent-foreground"
  >
    <Icon class="h-5 w-5" aria-hidden="true" />
  </div>

  <h3 class="font-headline text-lg font-semibold leading-snug tracking-tight">
    {title}
  </h3>
  <p class="mt-3 font-body text-[0.9375rem] leading-6 text-ink-muted">
    {description}
  </p>
</article>
