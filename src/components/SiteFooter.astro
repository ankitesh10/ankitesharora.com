---
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const currentHash = Astro.url.hash;

const footerLinks = [
  { href: "/#system", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/resume", label: "Resume" },
  { href: "/bot", label: "Ask the bot", className: "hidden md:inline-flex" },
].map((link) => {
  const url = new URL(link.href, Astro.url);
  const linkPath = url.pathname.replace(/\/+$/, "") || "/";
  const active = url.hash
    ? currentPath === linkPath &&
      (currentHash ? currentHash === url.hash : url.hash === "#system")
    : currentPath === linkPath;

  return {
    ...link,
    active,
  };
});
---

<footer
  class="fixed bottom-0 left-0 right-0 z-50 flex h-12 items-center justify-between border-t-2 border-chrome-border bg-chrome px-4 md:px-6 text-chrome-foreground shadow-[0_-1px_0_0_var(--color-border-muted)]"
>
  <p class="font-label text-xs text-chrome-muted">
    <span class="font-bold text-accent">Ankitesh Arora</span>
    <span class="hidden md:inline"> · © 2026</span>
  </p>

  <nav aria-label="Footer" class="flex gap-5 font-label text-xs md:gap-6">
    {
      footerLinks.map(({ href, label, active, className }) => (
        <a
          href={href}
          aria-current={active ? "page" : undefined}
          class:list={[
            "min-h-8 items-center transition-colors duration-150",
            className ?? "inline-flex",
            active
              ? "text-accent underline underline-offset-4"
              : "text-chrome-muted hover:text-accent",
          ]}
        >
          {label}
        </a>
      ))
    }
  </nav>
</footer>
