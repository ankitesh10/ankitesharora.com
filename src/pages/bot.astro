---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TopNavigation from "../components/TopNavigation.astro";
import { pageMetadata } from "../data/pageMetadata";
import { ArrowUp, Bot } from "@lucide/astro";
import "@xterm/xterm/css/xterm.css";

const botPage = pageMetadata.bot;
---

<BaseLayout
  title={botPage.title}
  description={botPage.description}
  canonicalPath={botPage.path}
>
  <main
    id="main-content"
    data-bot-page
    class="bot-page mx-auto mt-12 flex h-[calc(100dvh-6rem)] min-h-0 max-w-7xl items-stretch overflow-hidden px-4 py-3 sm:px-6 md:py-4"
  >
    <section
      class="bot-terminal-panel w-full overflow-hidden border-4 border-ink bg-panel shadow-[8px_8px_0_0_var(--color-ink)] sm:shadow-[12px_12px_0_0_var(--color-ink)]"
    >
      <TopNavigation />

      <header
        class="bot-header flex flex-col gap-2 border-b-4 border-ink bg-accent px-4 py-3 text-accent-foreground sm:flex-row sm:items-center sm:justify-between sm:px-5 md:py-4"
      >
        <div class="bot-heading">
          <span class="bot-avatar md:hidden" aria-hidden="true">
            <Bot size={20} />
          </span>
          <div>
            <p
              class="hidden font-label text-xs uppercase tracking-[0.3em] md:block"
            >
              TERMINAL_NODE;
            </p>
            <h1
              class="font-headline text-xl font-bold uppercase tracking-tight"
            >
              <span class="hidden md:inline">AA_BOT_INTERFACE;</span>
              <span class="md:hidden">Ask Ankitesh</span>
            </h1>
            <p class="bot-subtitle md:hidden">
              Work, projects &amp; experience
            </p>
          </div>
        </div>
        <div
          class="bot-connection font-label text-xs tracking-[0.16em] sm:tracking-[0.25em]"
          role="status"
          data-connection="connecting"
        >
          <span class="hidden md:inline"
            >STATUS: <span id="status">CONNECTING</span>;</span
          >
          <span id="mobile-status" class="md:hidden">Connecting…</span>
        </div>
      </header>

      <div
        class="hidden gap-2 border-b-4 border-ink bg-panel-muted px-4 py-3 font-label text-xs uppercase tracking-[0.14em] text-ink-muted md:flex md:justify-between md:px-5 md:tracking-[0.2em]"
      >
        <span>BOOT_SEQUENCE: OK;</span>
        <span>SESSION: LOCALHOST / PROTOCOL: XTERM;</span>
      </div>

      <div class="terminal-shell overflow-hidden px-4 py-4 sm:px-5">
        <div id="terminal" class="h-full w-full"></div>
      </div>

      <div class="mobile-chat">
        <div
          id="chat-messages"
          class="chat-messages"
          role="log"
          aria-label="Conversation with Ankitesh's bot"
          aria-live="polite"
          aria-relevant="additions text"
        >
        </div>
        <form id="chat-form" class="chat-composer">
          <label for="chat-input" class="sr-only">Message Ankitesh's bot</label>
          <div class="chat-input-row">
            <textarea
              id="chat-input"
              name="message"
              rows="1"
              placeholder="Ask me anything…"
              enterkeyhint="send"
              required></textarea>
            <button id="chat-send" type="submit" title="Send message" disabled>
              <ArrowUp size={20} aria-hidden="true" />
              <span class="sr-only">Send message</span>
            </button>
          </div>
          <p id="chat-status" class="chat-status" role="status"></p>
        </form>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .bot-terminal-panel {
    --bot-terminal-font:
      "SFMono-Regular", "Cascadia Code", "JetBrains Mono", "Fira Code",
      "IBM Plex Mono", "Roboto Mono", Menlo, Monaco, Consolas,
      "Liberation Mono", monospace;
    display: flex;
    flex-direction: column;
    font-family: var(--bot-terminal-font);
    min-height: 0;
    min-width: 0;
  }

  .terminal-shell {
    display: none;
    flex: 1 1 auto;
    min-height: 0;
    background: var(--color-chrome);
  }

  .mobile-chat {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    font-family: var(--font-body);
  }

  .chat-messages {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem 1rem;
    scroll-padding-block: 1.25rem;
  }

  .chat-messages :global(.chat-message) {
    width: fit-content;
    max-width: 100%;
    flex-shrink: 0;
  }

  .chat-messages :global(.chat-message[data-role="user"]) {
    margin-left: auto;
    max-width: 85%;
    padding: 0.625rem 0.875rem;
    background: var(--color-accent);
    color: var(--color-accent-foreground);
    border-radius: 0.25rem;
  }

  .chat-messages :global(.chat-message[data-role="user"] .chat-message-label) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .chat-messages :global(.chat-message-label) {
    margin-bottom: 0.25rem;
    color: var(--color-ink-muted);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chat-messages :global(.chat-message-text) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .chat-messages :global(.chat-message[data-state="error"]) {
    padding: 0.75rem;
    border-left: 2px solid var(--color-danger);
    background: var(--color-panel-muted);
  }

  .chat-composer {
    flex-shrink: 0;
    border-top: 1px solid var(--color-border-muted);
    padding: 0.75rem 1rem;
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }

  .chat-input-row {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    background: var(--color-panel-soft);
    padding: 0.25rem;
  }

  .chat-input-row:focus-within {
    border-color: var(--color-ink-muted);
    box-shadow: 0 0 0 1px var(--color-ink-muted);
  }

  #chat-input {
    flex: 1;
    min-width: 0;
    height: 2.75rem;
    min-height: 2.75rem;
    max-height: 7.5rem;
    resize: none;
    border: 0;
    background: transparent;
    padding: 0.625rem 0.5rem;
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
  }

  #chat-input:focus-visible {
    outline: none;
  }

  #chat-send {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.125rem;
    background: var(--color-accent);
    color: var(--color-accent-foreground);
    padding: 0.5rem;
    cursor: pointer;
  }

  #chat-send:disabled {
    background: var(--color-panel-muted);
    color: var(--color-ink-subtle);
    cursor: default;
  }

  .chat-status {
    padding-top: 0.5rem;
    color: var(--color-ink-muted);
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  .chat-status:empty {
    display: none;
  }

  @media (min-width: 48rem) {
    .terminal-shell {
      display: block;
    }
    .mobile-chat {
      display: none;
    }
  }

  @media (max-width: 47.999rem) {
    .bot-page {
      position: fixed;
      top: calc(3rem + var(--bot-viewport-top, 0px));
      width: 100%;
      height: calc(var(--bot-viewport-height, 100dvh) - 3rem);
      margin-top: 0;
      padding: 0;
    }

    .bot-terminal-panel {
      border: 0;
      box-shadow: none;
    }

    .bot-header {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
      gap: 0.5rem;
      border-bottom: 1px solid var(--color-border-muted);
      background: var(--color-panel);
      color: var(--color-ink);
      padding: 0.875rem 1rem;
    }

    .bot-heading {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }

    .bot-avatar {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      background: var(--color-accent);
      color: var(--color-accent-foreground);
      border-radius: 0.25rem;
    }

    .bot-header h1 {
      font-size: 1.125rem;
      line-height: 1.5rem;
      text-transform: none;
      letter-spacing: -0.025em;
    }

    .bot-subtitle {
      margin-top: 0.125rem;
      color: var(--color-ink-muted);
      font-size: 0.75rem;
      line-height: 1rem;
    }

    .bot-connection {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      flex-shrink: 0;
      color: var(--color-ink-muted);
      font-size: 0.6875rem;
      letter-spacing: 0;
    }

    .bot-connection::before {
      content: "";
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 50%;
      background: currentColor;
    }

    .bot-connection[data-connection="connected"]::before {
      background: var(--color-accent-strong);
    }

    .bot-connection[data-connection="offline"]::before {
      background: var(--color-danger);
    }

    :global(body:has([data-bot-page]) > footer) {
      display: none;
    }

    :global(body:has([data-bot-page]) > .scanline) {
      display: none;
    }
  }

  @media (max-width: 47.999rem) and (max-height: 500px) {
    .bot-header {
      padding-block: 0.5rem;
    }
    .bot-subtitle {
      display: none;
    }
    .bot-avatar {
      width: 2rem;
      height: 2rem;
    }
  }

  @media (max-width: 359px) {
    .bot-avatar {
      display: none;
    }
  }

  #terminal {
    overflow: hidden;
    background: var(--color-chrome);
  }

  #terminal :global(.xterm) {
    height: 100%;
    background: var(--color-chrome);
    font-family: var(--bot-terminal-font);
  }

  #terminal :global(.xterm-screen),
  #terminal :global(.xterm-viewport) {
    background: var(--color-chrome);
  }

  :global(body:has([data-bot-page])) {
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
  }
</style>

<script>
  import { startBotTerminal } from "../lib/bot/terminalSession";

  const setBotStatus = async () => {
    const statusElement = document.querySelector("#status");
    const mobileStatus = document.querySelector("#mobile-status");
    const connection = document.querySelector<HTMLElement>(".bot-connection");
    if (!statusElement || !mobileStatus || !connection) return;

    const updateConnection = (connected: boolean) => {
      statusElement.textContent = connected ? "CONNECTED" : "UNABLE_TO_CONNECT";
      mobileStatus.textContent = connected ? "Online" : "Offline";
      connection.dataset.connection = connected ? "connected" : "offline";
    };

    try {
      const response = await fetch(`${import.meta.env.PUBLIC_API_URL}/health`);
      const data = await response.json();
      updateConnection(
        response.ok && data?.status === "up" && data?.database?.status === "up",
      );
    } catch {
      updateConnection(false);
    }
  };

  // Follow the visible viewport when a mobile keyboard opens or closes.
  const syncViewport = () => {
    const viewport = window.visualViewport;
    if (!viewport) return;
    document.documentElement.style.setProperty(
      "--bot-viewport-height",
      `${viewport.height}px`,
    );
    document.documentElement.style.setProperty(
      "--bot-viewport-top",
      `${viewport.offsetTop}px`,
    );
  };
  window.visualViewport?.addEventListener("resize", syncViewport);
  window.visualViewport?.addEventListener("scroll", syncViewport);
  syncViewport();

  setBotStatus();

  startBotTerminal({
    endpoint: `${import.meta.env.PUBLIC_API_URL}/bot`,
    terminalSelector: "#terminal",
  });
</script>
