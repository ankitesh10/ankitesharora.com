---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TopNavigation from "../components/TopNavigation.astro";
import { pageMetadata } from "../data/pageMetadata";
import "@xterm/xterm/css/xterm.css";

const botPage = pageMetadata.bot;
---

<BaseLayout
  title={botPage.title}
  description={botPage.description}
  canonicalPath={botPage.path}
>
  <main
    id="main-content"
    class="mx-auto flex min-h-[calc(100dvh-3rem)] max-w-7xl items-center px-6 pt-12 pb-16 md:pt-16"
  >
    <section
      class="w-full overflow-hidden border-4 border-ink bg-panel shadow-[12px_12px_0_0_var(--color-ink)]"
    >
      <TopNavigation />

      <header
        class="flex items-center justify-between gap-4 border-b-4 border-ink bg-accent px-5 py-4 text-accent-foreground"
      >
        <div>
          <p class="font-label text-xs uppercase tracking-[0.3em]">
            TERMINAL_NODE;
          </p>
          <h1 class="font-headline text-xl font-bold uppercase tracking-tight">
            AA_BOT_INTERFACE;
          </h1>
        </div>
        <div class="font-label text-xs tracking-[0.25em]">
          STATUS: UNDER_DEVELOPMENT;
        </div>
      </header>

      <div
        class="border-b-4 border-ink bg-panel-muted px-5 py-3 font-label text-xs uppercase tracking-[0.2em] text-ink-muted flex justify-between"
      >
        <span>BOOT_SEQUENCE: OK;</span>
        <span>SESSION: LOCALHOST / PROTOCOL: XTERM;</span>
      </div>

      <div class="terminal-shell overflow-hidden px-5 h-[calc(100dvh-17rem)]">
        <div id="terminal" class="h-full w-full"></div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .terminal-shell {
    background: var(--color-chrome);
  }

  #terminal {
    overflow: hidden;
    background: var(--color-chrome);
  }

  #terminal :global(.xterm) {
    height: 100%;
    background: var(--color-chrome);
  }

  #terminal :global(.xterm-screen),
  #terminal :global(.xterm-viewport) {
    height: 100% !important;
    background: var(--color-chrome);
  }

  #terminal :global(.xterm-viewport) {
    overflow-y: auto;
  }
</style>

<script>
  import { Terminal } from "@xterm/xterm";
  import {
    parseJsonEventStream,
    readUIMessageStream,
    uiMessageChunkSchema,
    type UIMessage,
  } from "ai";

  const getTerminalBackground = () =>
    getComputedStyle(document.documentElement)
      .getPropertyValue("--color-chrome")
      .trim() || "hsl(0 0% 5.5%)";

  const getTerminalPalette = () => ({
    background: getTerminalBackground(),
    foreground: "hsl(0 0% 97.6%)",
    cursor: "hsl(115 100% 78.8%)",
    cursorAccent: getTerminalBackground(),
    selectionBackground:
      "color-mix(in srgb, hsl(115 100% 78.8%) 28%, transparent)",
    black: getTerminalBackground(),
    red: "hsl(12 100% 65.9%)",
    green: "hsl(115 100% 78.8%)",
    yellow: "color-mix(in srgb, hsl(115 100% 78.8%) 55%, hsl(0 0% 97.6%))",
    blue: "hsl(186 100% 49.6%)",
    magenta: "color-mix(in srgb, hsl(12 100% 65.9%) 45%, hsl(0 0% 97.6%))",
    cyan: "hsl(186 100% 49.6%)",
    white: "hsl(0 0% 97.6%)",
    brightBlack: "hsl(0 0% 33.3%)",
    brightRed: "color-mix(in srgb, hsl(12 100% 65.9%) 70%, hsl(0 0% 97.6%))",
    brightGreen: "color-mix(in srgb, hsl(115 100% 78.8%) 70%, hsl(0 0% 97.6%))",
    brightYellow:
      "color-mix(in srgb, hsl(115 100% 78.8%) 40%, hsl(0 0% 97.6%))",
    brightBlue: "color-mix(in srgb, hsl(186 100% 49.6%) 70%, hsl(0 0% 97.6%))",
    brightMagenta:
      "color-mix(in srgb, hsl(12 100% 65.9%) 30%, hsl(0 0% 97.6%))",
    brightCyan: "color-mix(in srgb, hsl(186 100% 49.6%) 40%, hsl(0 0% 97.6%))",
    brightWhite: "hsl(0 0% 97.6%)",
  });

  const terminalElement = document.getElementById("terminal");
  let term: Terminal;

  function convertStringToBlue(text: string) {
    return `\x1B[3;34m${text}\x1B[0m`;
  }

  const botuser = `${convertStringToBlue("aa_bot@ ankitesharora.com:~$ ")}`;
  const vistor = `${convertStringToBlue("visitor@ ankitesharora.com:~$ ")}`;

  const messages: UIMessage[] = [];

  const createTextMessage = (
    role: Extract<UIMessage["role"], "user" | "assistant">,
    text: string,
  ): UIMessage => ({
    id: crypto.randomUUID(),
    role,
    parts: [{ type: "text", text }],
  });

  const createUIMessageChunkStream = (stream: ReadableStream<Uint8Array>) =>
    parseJsonEventStream({
      stream,
      schema: uiMessageChunkSchema,
    }).pipeThrough(
      new TransformStream({
        transform(chunk, controller) {
          if (!chunk.success) {
            throw chunk.error;
          }

          controller.enqueue(chunk.value);
        },
      }),
    );

  const getMessageText = (message: UIMessage) =>
    message.parts
      .filter((part) => part.type === "text")
      .map((part) => part.text)
      .join("");

  if (terminalElement) {
    term = new Terminal({
      cursorBlink: true,
      convertEol: true,
      fontFamily: '"Space Grotesk Variable", "Space Grotesk", monospace',
      fontSize: 13,
      lineHeight: 1.2,
      theme: getTerminalPalette(),
    });

    term.open(terminalElement);
    term.write(botuser);
    term.write(`Hello from \x1B[1;3;31maa_bot\x1B[0m. Ask anything about me!`);
    term.writeln("");
    term.write(vistor);

    let input = "";
    let isStreaming = false;

    term.onData(async (e) => {
      if (isStreaming) {
        return;
      }

      if (e === "\r") {
        const userInput = input.trim();

        if (!userInput) {
          term.write("\r\n");
          term.write(vistor);
          input = "";
          return;
        }

        messages.push(createTextMessage("user", userInput));
        input = "";
        isStreaming = true;
        term.write("\r\n");
        term.write(botuser);

        try {
          const response = await fetch("http://localhost:3001/bot", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ messages }),
          });

          if (!response.ok) {
            throw new Error(`Bot request failed: ${response.status}`);
          }

          if (!response.body) {
            throw new Error("Response body is null");
          }

          let assistantMessage: UIMessage | undefined;
          let writtenText = "";

          for await (const message of readUIMessageStream({
            stream: createUIMessageChunkStream(response.body),
          })) {
            console.log("message", message);

            assistantMessage = message;
            const nextText = getMessageText(message);

            if (nextText.startsWith(writtenText)) {
              term.write(nextText.slice(writtenText.length));
            } else {
              term.write(nextText);
            }

            writtenText = nextText;
          }

          if (assistantMessage) {
            messages.push(assistantMessage);
          }
        } catch (error) {
          console.error(error);
          term.write("\x1B[31mConnection error. Check the bot API.\x1B[0m");
        } finally {
          isStreaming = false;
          term.writeln("");
          term.write(vistor);
        }
      } else if (e === "\x7f") {
        // Backspace (ASCII DEL)
        // Check if there is text to delete before calling
        if (input.length > 0) {
          input = input.slice(0, -1);
          term.write("\b \b");
        }
      } else {
        input += e;
        term.write(e);
      }
    });

    document.addEventListener("themechange", () => {
      term.options.theme = getTerminalPalette();
      term.refresh(0, term.rows - 1);
    });
  }
</script>
