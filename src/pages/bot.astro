---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TopNavigation from "../components/TopNavigation.astro";
import { pageMetadata } from "../data/pageMetadata";
import "@xterm/xterm/css/xterm.css";

const botPage = pageMetadata.bot;
---

<BaseLayout
  title={botPage.title}
  description={botPage.description}
  canonicalPath={botPage.path}
>
  <main
    id="main-content"
    data-bot-page
    class="mx-auto mt-12 flex h-[calc(100dvh-6rem)] min-h-0 max-w-7xl items-stretch overflow-hidden px-4 py-3 sm:px-6 md:py-4"
  >
    <section
      class="bot-terminal-panel w-full overflow-hidden border-4 border-ink bg-panel shadow-[8px_8px_0_0_var(--color-ink)] sm:shadow-[12px_12px_0_0_var(--color-ink)]"
    >
      <TopNavigation />

      <header
        class="flex flex-col gap-3 border-b-4 border-ink bg-accent px-4 py-4 text-accent-foreground sm:flex-row sm:items-center sm:justify-between sm:px-5"
      >
        <div>
          <p
            class="font-label text-xs uppercase tracking-[0.2em] sm:tracking-[0.3em]"
          >
            TERMINAL_NODE;
          </p>
          <h1 class="font-headline text-xl font-bold uppercase tracking-tight">
            AA_BOT_INTERFACE;
          </h1>
        </div>
        <div class="font-label text-xs tracking-[0.16em] sm:tracking-[0.25em]">
          STATUS: <span id="status">INITIATING_SEQUENCE</span>;
        </div>
      </header>

      <div
        class="flex flex-col gap-2 border-b-4 border-ink bg-panel-muted px-4 py-3 font-label text-xs uppercase tracking-[0.14em] text-ink-muted sm:flex-row sm:justify-between sm:px-5 sm:tracking-[0.2em]"
      >
        <span>BOOT_SEQUENCE: OK;</span>
        <span>SESSION: LOCALHOST / PROTOCOL: XTERM;</span>
      </div>

      <div class="terminal-shell overflow-hidden px-4 py-4 sm:px-5">
        <div id="terminal" class="h-full w-full"></div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .bot-terminal-panel {
    --bot-terminal-font:
      "SFMono-Regular", "Cascadia Code", "JetBrains Mono", "Fira Code",
      "IBM Plex Mono", "Roboto Mono", Menlo, Monaco, Consolas,
      "Liberation Mono", monospace;
    display: flex;
    flex-direction: column;
    font-family: var(--bot-terminal-font);
    min-height: 0;
  }

  .terminal-shell {
    flex: 1 1 auto;
    min-height: 0;
    background: var(--color-chrome);
  }

  #terminal {
    overflow: hidden;
    background: var(--color-chrome);
  }

  #terminal :global(.xterm) {
    height: 100%;
    background: var(--color-chrome);
    font-family: var(--bot-terminal-font);
  }

  #terminal :global(.xterm-screen),
  #terminal :global(.xterm-viewport) {
    background: var(--color-chrome);
  }

  :global(body:has([data-bot-page])) {
    height: 100dvh;
    overflow: hidden;
  }
</style>

<script>
  import { startBotTerminal } from "../lib/bot/terminalSession";

  const setBotStatus = async () => {
    const response = await fetch(`${import.meta.env.PUBLIC_API_URL}/health`);
    const data = await response.json();

    let aa_bot_status =
      data?.status === "up" && data?.database?.status === "up"
        ? "CONNECTED"
        : "UNABLE_TO_CONNECT";

    const statusElement = document.querySelector("#status");

    if (statusElement?.innerHTML) {
      statusElement.innerHTML = aa_bot_status;
    }
  };

  setBotStatus();

  startBotTerminal({
    endpoint: `${import.meta.env.PUBLIC_API_URL}/bot`,
    terminalSelector: "#terminal",
  });
</script>
