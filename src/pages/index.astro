---
import { Image } from "astro:assets";
import {
  ArrowDownRight,
  ArrowUpRight,
  FolderGit2,
  Link,
  Mail,
} from "@lucide/astro";
import ArchiveItem from "../components/ArchiveItem.astro";
import ModuleCard from "../components/ModuleCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TopNavigation from "../components/TopNavigation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageMetadata } from "../data/pageMetadata";
import heroImage from "../assets/aa_web.webp";

const moduleCards = [
  {
    code: "MOD_01",
    title: "Frontend engineering",
    description:
      "React, TypeScript, Next.js, Remix, responsive UI engineering, performance optimization, and frontend testing.",
    icon: "architecture",
  },
  {
    code: "MOD_02",
    title: "Backend systems",
    description:
      "Node.js, API development, server-side architecture, integrations, and application logic for production systems.",
    icon: "developer_board",
  },
  {
    code: "MOD_03",
    title: "Data & persistence",
    description:
      "PostgreSQL, relational schema design, querying, performance-aware data access, and reliable persistence workflows.",
    icon: "database",
  },
  {
    code: "MOD_04",
    title: "Cloud & delivery",
    description:
      "AWS, Docker, deployment workflows, environment management, and scalable delivery pipelines.",
    icon: "cloud_upload",
  },
];

const archiveItems = [
  {
    period: "May 2025 — Present",
    company: "Thrillophilia",
    location: "Jaipur",
    title: "Senior Software Engineer",
    bullets: [
      "Decoupled the React app from the Ruby on Rails framework and migrated the bundler to Vite, reducing frontend and backend build time by over 95%.",
      "Implemented multi-payment support on the checkout page to improve the experience of thousands of monthly users.",
      "Led the frontend of the AI-based itinerary builder, improving the time to share an itinerary with end users by over 60%.",
      "Integrated ESLint and Prettier GitHub Action to improve and maintain code quality.",
      "Integrated Playwright for E2E testing to improve product reliability, including coverage for the login flow under E2E tests.",
    ],
    highlighted: true,
  },
  {
    period: "Oct 2024 — Apr 2025",
    company: "Postman",
    location: "Bengaluru",
    title: "Software Engineer II",
    bullets: [
      "Implemented UI/UX improvements to mock servers at Postman, reducing the number of steps needed to create a mock server for nearly 56 million paid users.",
      "Added support for loading collection diff asynchronously, improving efficiency for large orgs that rely on these large diffs.",
      "Improved the UI of the collection sidebar context menu, enhancing usability, responsiveness, and logical grouping of menu actions.",
    ],
  },
  {
    period: "Apr 2024 — Oct 2024",
    company: "Jio Haptik, Reliance Jio Platform",
    location: "Mumbai",
    title: "Software Engineer III, Frontend",
    hideDivider: true,
    bullets: [
      "Led the migration to Vite bundler and React 18, resulting in a 40% improvement in re-rendering performance and a 70% reduction in build time, with better hot reload performance and roughly 20% higher developer productivity.",
      "Held weekly review meetings with the team for technical discussion, feedback, and engineering growth.",
    ],
  },
  {
    period: "May 2021 — Mar 2024",
    company: "",
    location: "",
    title: "Software Engineer II, Frontend",
    bullets: [
      "Worked on features including WhatsApp carousel card templates, Instagram, Announcement Hub, and Ad Performance, ensuring strong UX across desktop and mobile web platforms.",
      "Enhanced Inbox performance by over 30%, improving user engagement.",
      "Worked on Storybook and design system integration, improving design consistency across the project and increasing developer productivity.",
      "Identified and improved the UX of Instagram's embedded signup flow, increasing signup success rate from 14% to 71%.",
    ],
  },
  {
    period: "Oct 2019 — Mar 2021",
    company: "AppLaunch",
    location: "Bengaluru",
    title: "React JS Team Lead & React Native Developer",
    bullets: [
      "Led and mentored the React JS team, establishing coding standards and best practices.",
      "Worked on two React Native projects, including an audio live-streaming platform.",
    ],
  },
  {
    period: "Jan 2018 — Oct 2019",
    company: "Cbetter",
    location: "Jaipur",
    title: "Web Developer",
    bullets: [
      "Worked on various frontend and CMS projects, including a website for AUBank Foundation and an interactive schedule portal for the Nasscom Product Conclave.",
    ],
  },
];

const homePage = pageMetadata.home;
---

<BaseLayout
  title={homePage.title}
  description={homePage.description}
  canonicalPath={homePage.path}
  appearance="minimal"
>
  <div id="top">
    <TopNavigation />
    <main
      id="main-content"
      class="mx-auto max-w-7xl space-y-20 px-5 pb-28 pt-24 sm:space-y-24 sm:px-8 lg:space-y-28 lg:px-12 lg:pt-32"
    >
      <section
        id="system"
        aria-labelledby="system-heading"
        class="grid scroll-mt-24 overflow-hidden border border-border-muted bg-panel lg:grid-cols-12"
      >
        <div
          class="flex flex-col justify-center p-6 py-10 sm:p-10 lg:col-span-8 lg:p-12"
        >
          <p
            class="font-label text-xs font-medium uppercase tracking-[0.18em] text-ink-muted"
          >
            Ankitesh Arora <span class="mx-2 text-ink-subtle" aria-hidden="true"
              >/</span
            > Jaipur, India
          </p>
          <h1
            id="system-heading"
            class="mt-6 max-w-3xl font-headline text-[clamp(2.5rem,5.5vw,4.5rem)] font-bold leading-[1.05] tracking-[-0.05em]"
          >
            Senior software<br />engineer<span class="text-ink-muted"
              >.<br />Frontend focused.</span
            >
          </h1>
          <p
            class="mt-6 max-w-lg text-base leading-relaxed text-ink-muted sm:text-lg"
          >
            I build thoughtful interfaces and reliable web applications, from
            React and TypeScript to the systems behind them.
          </p>
          <div
            class="mt-8 flex flex-col items-stretch gap-3 font-label text-sm font-semibold sm:flex-row sm:items-center sm:gap-6"
          >
            <a
              aria-label="Book a meeting with Ankitesh Arora on Calendly"
              class="inline-flex min-h-12 items-center justify-center gap-3 bg-accent px-5 py-3 text-accent-foreground transition-colors hover:bg-accent-strong"
              href="https://calendly.com/ankitesh4/30min"
              target="_blank"
              rel="noreferrer"
            >
              Let's talk <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
            </a>
            <a
              class="inline-flex min-h-12 items-center justify-center gap-3 px-1 py-3 text-ink-muted underline-offset-4 transition-colors hover:text-ink hover:underline"
              href="#archive"
            >
              Explore my work <ArrowDownRight
                class="h-4 w-4"
                aria-hidden="true"
              />
            </a>
          </div>
        </div>
        <div
          class="relative aspect-[4/3] overflow-hidden border-t border-border-muted sm:aspect-[16/9] lg:col-span-4 lg:aspect-auto lg:border-l lg:border-t-0"
        >
          <Image
            class="absolute inset-0 h-full w-full object-cover object-[center_35%] grayscale"
            src={heroImage}
            alt="Ankitesh Arora"
            sizes="(min-width: 1280px) 395px, (min-width: 1024px) 33vw, 100vw"
            loading="eager"
            format="webp"
          />
          <div
            class="absolute bottom-5 left-5 bg-chrome/90 px-3 py-2 font-label text-[10px] uppercase tracking-[0.14em] text-chrome-foreground"
          >
            Software engineer / Frontend
          </div>
        </div>
      </section>

      <section
        id="stack"
        aria-labelledby="stack-heading"
        class="scroll-mt-24 space-y-8"
      >
        <SectionHeading
          id="stack-heading"
          title="Core expertise"
          number="01"
          meta="The tools behind the work"
        />
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {moduleCards.map((card) => <ModuleCard {...card} />)}
        </div>
      </section>

      <div
        class="grid grid-cols-1 items-start gap-16 lg:grid-cols-12 lg:gap-12"
      >
        <section
          id="archive"
          aria-labelledby="archive-heading"
          class="scroll-mt-24 space-y-8 lg:col-span-8"
        >
          <SectionHeading
            id="archive-heading"
            title="Work experience"
            number="02"
            meta="2018 — Present"
          />
          <div class="border border-border-muted bg-panel">
            {archiveItems.map((item) => <ArchiveItem {...item} />)}
          </div>
        </section>

        <section
          aria-labelledby="credentials-heading"
          class="space-y-8 lg:col-span-4"
        >
          <SectionHeading
            id="credentials-heading"
            title="Education"
            number="03"
          />
          <article class="border-l-2 border-border-muted pl-6">
            <p class="font-label text-xs tracking-wide text-ink-muted">
              2014 — 2018
            </p>
            <h3 class="mt-3 text-xl font-semibold tracking-tight">
              JECRC, Jaipur
            </h3>
            <p class="mt-3 text-base leading-relaxed text-ink-muted">
              B.Tech in Information Technology
            </p>
          </article>
        </section>
      </div>

      <section
        id="contact"
        aria-labelledby="contact-heading"
        class="scroll-mt-24 border-t border-border-muted pt-12 sm:pt-16"
      >
        <div
          class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
        >
          <div class="max-w-xl">
            <p
              class="font-label text-xs uppercase tracking-[0.18em] text-ink-muted"
            >
              04 / Get in touch
            </p>
            <h2
              id="contact-heading"
              class="mt-4 font-headline text-4xl font-bold leading-tight tracking-[-0.04em] sm:text-5xl"
            >
              Have something in mind?
            </h2>
            <p class="mt-4 text-base leading-relaxed text-ink-muted sm:text-lg">
              Have an exciting project you need help with? Let's talk.
            </p>
          </div>
          <a
            class="inline-flex min-h-12 shrink-0 items-center justify-center gap-3 self-start bg-accent px-6 py-3 font-semibold text-accent-foreground transition-colors hover:bg-accent-strong"
            href="mailto:ankitesh4@gmail.com"
          >
            <Mail class="h-5 w-5" aria-hidden="true" />
            Send an email <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
        <div
          class="mt-10 flex flex-wrap gap-x-8 gap-y-4 border-t border-border-muted pt-6"
        >
          <a
            class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink-muted underline-offset-4 hover:text-ink hover:underline"
            href="https://github.com/ankitesh10"
            target="_blank"
            rel="noreferrer"
            aria-label="Visit Ankitesh Arora on GitHub"
          >
            <FolderGit2 class="h-4 w-4" aria-hidden="true" /> GitHub
            <ArrowUpRight class="h-3 w-3" aria-hidden="true" />
          </a>
          <a
            class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink-muted underline-offset-4 hover:text-ink hover:underline"
            href="https://www.linkedin.com/in/ankitesharora/"
            target="_blank"
            rel="noreferrer"
            aria-label="Visit Ankitesh Arora on LinkedIn"
          >
            <Link class="h-4 w-4" aria-hidden="true" /> LinkedIn
            <ArrowUpRight class="h-3 w-3" aria-hidden="true" />
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
