---
import { ArrowRight, FileText } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TopNavigation from "../components/TopNavigation.astro";
import { pageMetadata } from "../data/pageMetadata";

const previewTopics = [
  "State machines, and why to use one",
  "Scaling a web app: the tools you need",
  "Monorepo architecture: the good and the bad",
];

const blogPage = pageMetadata.blog;
---

<BaseLayout
  title={blogPage.title}
  description={blogPage.description}
  canonicalPath={blogPage.path}
  appearance="minimal"
>
  <TopNavigation />

  <main
    id="main-content"
    class="mx-auto flex min-h-dvh max-w-4xl items-center px-5 pb-28 pt-24 sm:px-8"
  >
    <section class="w-full border border-border-muted bg-panel p-8 sm:p-12">
      <p
        class="inline-flex items-center gap-2 bg-accent/20 px-3 py-1 font-label text-sm font-medium"
      >
        <span class="h-2 w-2 animate-pulse bg-accent-strong" aria-hidden="true"
        ></span>
        Coming soon
      </p>

      <h1
        class="mt-6 font-headline text-4xl font-bold leading-tight tracking-[-0.04em] sm:text-5xl"
      >
        The blog is on its way.
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink-muted">
        I'm writing up what I've learned building frontend systems. The first
        posts will cover:
      </p>

      <ul class="mt-8 divide-y divide-border-muted border-y border-border-muted">
        {
          previewTopics.map((topic, index) => (
            <li class="flex gap-4 py-4 text-base">
              <span class="font-label text-sm text-ink-muted">
                0{index + 1}
              </span>
              <span>{topic}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-col gap-3 font-label text-sm font-semibold sm:flex-row sm:items-center sm:gap-6">
        <a
          href="/"
          class="inline-flex min-h-12 items-center justify-center gap-3 bg-accent px-6 py-3 text-accent-foreground transition-colors hover:bg-accent-strong"
        >
          Back to home <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
        <a
          href="/resume"
          class="inline-flex min-h-12 items-center justify-center gap-2 px-1 py-3 text-ink-muted underline-offset-4 transition-colors hover:text-ink hover:underline"
        >
          <FileText class="h-4 w-4" aria-hidden="true" /> View my resume
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
