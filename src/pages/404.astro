---
import { ArrowRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TopNavigation from "../components/TopNavigation.astro";
import { pageMetadata } from "../data/pageMetadata";

const notFoundPage = pageMetadata.notFound;
---

<BaseLayout
  title={notFoundPage.title}
  description={notFoundPage.description}
  canonicalPath={notFoundPage.path}
  appearance="minimal"
>
  <TopNavigation />

  <main
    id="main-content"
    class="mx-auto flex min-h-dvh max-w-4xl items-center px-5 pb-28 pt-24 sm:px-8"
  >
    <section class="w-full border border-border-muted bg-panel p-8 sm:p-12">
      <p class="font-label text-sm font-medium text-ink-muted">Error 404</p>
      <h1
        class="mt-4 font-headline text-4xl font-bold leading-tight tracking-[-0.04em] sm:text-5xl"
      >
        We couldn't find that page.
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink-muted">
        The link may be broken or the page may have moved. Here's where you can
        go next.
      </p>

      <nav
        aria-label="Helpful links"
        class="mt-10 flex flex-col gap-3 font-label text-sm font-semibold sm:flex-row sm:items-center sm:gap-6"
      >
        <a
          href="/"
          class="inline-flex min-h-12 items-center justify-center gap-3 bg-accent px-6 py-3 text-accent-foreground transition-colors hover:bg-accent-strong"
        >
          Back to home <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
        <a
          href="/resume"
          class="inline-flex min-h-12 items-center justify-center px-1 py-3 text-ink-muted underline-offset-4 transition-colors hover:text-ink hover:underline"
        >
          View resume
        </a>
        <a
          href="/blog"
          class="inline-flex min-h-12 items-center justify-center px-1 py-3 text-ink-muted underline-offset-4 transition-colors hover:text-ink hover:underline"
        >
          Read the blog
        </a>
      </nav>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
